# BotFather bergan tokenni shu yerga qo'ying
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Railway/Render sizga bergan haqiqiy domen (masalan: https://pul-nazorati.up.railway.app)
WEBAPP_URL=https://your-app-domain.up.railway.app

# Serverni ishga tushirish porti (Railway/Render buni o'zi beradi, o'zgartirish shart emas)
PORT=3000

# Lokal (kompyuteringizda) Telegramsiz sinash uchun true qiling.
# Productionda (haqiqiy ishlatishda) albatta false yoki umuman qo'ymang!
ALLOW_DEV_NO_AUTH=false
